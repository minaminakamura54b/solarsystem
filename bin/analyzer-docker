#!/usr/bin/env bash
# 開発用: 解析エンジン（python -m analyzer）を Docker（linux/amd64）のコンテナの中で動かす。
# config/analyzer.yml の development で ANALYZER_DOCKER=1 のときに使われる（docs/LAYOUT_OVERLAY_DESIGN.md の F）。
# コンテナは bin/analyzer-container up で用意する。プロジェクトを同じパスでマウントしているので、ファイルのパスはそのまま渡せる。
# 注意: Rails が時間切れでこのスクリプトを止めても、コンテナの中の処理は最後まで動くことがある（開発用のため許容）
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CONTAINER="${ANALYZER_CONTAINER:-solarsight-analyzer}"
DOCKER="${DOCKER:-$(command -v docker || echo /Applications/Docker.app/Contents/Resources/bin/docker)}"
env_args=()
for name in DJI_IRP_PATH DJI_IRP_LIB_DIR; do
  if [ -n "${!name:-}" ]; then env_args+=(-e "$name=${!name}"); fi
done
# env_args が空のとき、macOS の bash 3.2 は set -u で "${env_args[@]}" をエラーにするため、空なら何も渡さない
exec "$DOCKER" exec -i ${env_args[@]+"${env_args[@]}"} -w "$ROOT/analyzer" "$CONTAINER" /opt/venv/bin/python -m analyzer "$@"
