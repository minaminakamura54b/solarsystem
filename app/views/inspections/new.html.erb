<% content_for :title, "新規点検" %>

<div class="page-header">
  <div>
    <h2 class="page-title">🔍 新規点検</h2>
    <p class="text-sm text-gray-500 mt-1"><%= current_site&.name %></p>
  </div>
  <%= link_to "← 一覧に戻る", inspections_path, class: "btn btn-secondary" %>
</div>

<div class="p-6 max-w-3xl">
  <div class="card p-6">
    <%= form_with model: @inspection, url: inspections_path, data: { controller: "upload-form" } do |f| %>
      <% messages = @inspection.display_error_messages %>
      <% if messages.any? %>
        <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-4">
          <% messages.each do |msg| %>
            <p class="text-red-700 text-sm"><%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <div class="space-y-4">
        <div>
          <label class="form-label">点検日時</label>
          <%= f.datetime_local_field :conducted_at,
              value: @inspection.conducted_at&.strftime("%Y-%m-%dT%H:%M") || Time.current.strftime("%Y-%m-%dT%H:%M"),
              class: "form-input" %>
        </div>

        <div>
          <label class="form-label">サーモ画像（R-JPEG）と RGB 画像</label>
          <div class="dropzone"
               data-upload-form-target="dropzone"
               data-action="dragover->upload-form#dragover dragleave->upload-form#dragleave drop->upload-form#drop">
            <div class="text-4xl mb-2">📷</div>
            <p class="text-gray-600 font-medium">画像をまとめてドラッグ＆ドロップ</p>
            <p class="text-gray-400 text-sm mt-1">または</p>
            <label class="btn btn-secondary mt-2 cursor-pointer">
              ファイルを選択
              <%= f.file_field :files, multiple: true, direct_upload: true, accept: "image/*",
                  class: "hidden",
                  data: { upload_form_target: "fileInput", action: "change->upload-form#fileSelected" } %>
            </label>
            <p class="text-xs text-gray-400 mt-2">
              ファイル名の末尾が <code>_T</code> の画像をサーモ画像、<code>_V</code> の画像を同時撮影の RGB としてペアにします
              （例: DJI_0001_T.JPG と DJI_0001_V.JPG）。末尾に _T / _V が無い画像はサーモ画像として扱います。
            </p>
          </div>
          <div class="mt-3 hidden" data-upload-form-target="summary">
            <p class="text-sm font-medium mb-2" data-upload-form-target="summaryText"></p>
            <ul class="text-xs text-gray-500 space-y-1" data-upload-form-target="list"></ul>
          </div>
        </div>

        <div>
          <label class="form-label">天候メモ（任意）</label>
          <%= f.text_area :weather_note, class: "form-textarea", rows: 2, placeholder: "例：快晴、雲なし" %>
        </div>

        <div class="bg-blue-50 rounded-lg p-4 text-sm text-blue-700">
          <strong>登録後の流れ：</strong>
          画像ごとにメタデータ（撮影時刻・カメラ・位置・温度データの有無）を読み取り、品質チェックを行います。
          日射量などの気象データは、登録後の点検詳細画面で入力すると、撮影時刻に合わせて各画像に割り当てます。
          温度データの解析（パネルごとの温度と異常候補）は、解析エンジンの接続後に行います。
        </div>

        <div class="flex justify-end gap-3">
          <%= link_to "キャンセル", inspections_path, class: "btn btn-secondary" %>
          <%= f.submit "アップロードして登録", class: "btn btn-primary",
              data: { upload_form_target: "submitBtn", disable_with: "アップロード中..." } %>
        </div>
      </div>
    <% end %>
  </div>
</div>
