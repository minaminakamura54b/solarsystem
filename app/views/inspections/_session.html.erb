<%# 新方式の点検（複数画像のセッション）の表示 %>
<% counts = @inspection.image_status_counts %>
<div class="p-6 space-y-6"
     <% if @inspection.in_progress? %>
       data-controller="auto-refresh"
       data-auto-refresh-url-value="<%= inspection_path(@inspection, format: :json) %>"
       data-auto-refresh-interval-value="3000"
       data-auto-refresh-max-value="<%= (AnalyzerConfig.current.stale_after_minutes + 5) * 60 * 1000 %>"
     <% end %>>

  <%# ── サマリー ─────────────────────────────── %>
  <div class="card p-4">
    <div style="display:flex; flex-wrap:wrap; gap:1.5rem; align-items:center;">
      <div>
        <p style="font-size:0.65rem; color:var(--gray-400); text-transform:uppercase; letter-spacing:0.1em;">状況</p>
        <p style="font-weight:600; font-size:1rem;"><%= inspection_status_label(@inspection) %></p>
      </div>
      <div>
        <p style="font-size:0.65rem; color:var(--gray-400); text-transform:uppercase; letter-spacing:0.1em;">画像</p>
        <p style="font-size:0.9rem;">
          全 <%= @images.size %> 枚
          <% counts.except("pending").each do |status, n| %>
            ／ <%= { "analyzing" => "解析中", "completed" => "解析完了", "needs_review" => "要確認", "failed" => "失敗", "excluded" => "除外" }[status] %> <%= n %>
          <% end %>
          <% waiting = @inspection.images_waiting_for_analyzer %>
          <% checking = @images.count(&:quality_pending?) %>
          <% if checking > 0 %>／ 品質チェック中 <%= checking %><% end %>
          <% if waiting > 0 %>／ 解析待ち <%= waiting %><% end %>
        </p>
      </div>
      <div>
        <p style="font-size:0.65rem; color:var(--gray-400); text-transform:uppercase; letter-spacing:0.1em;">異常の候補（未確定）</p>
        <p style="font-size:0.9rem;"><%= @inspection.candidate_count %> 件</p>
      </div>
      <div>
        <p style="font-size:0.65rem; color:var(--gray-400); text-transform:uppercase; letter-spacing:0.1em;">重要度</p>
        <% if @inspection.completed? && @inspection.severity %>
          <span class="badge <%= @inspection.severity_color_class %>"><%= @inspection.severity_label %></span>
        <% else %>
          <p style="font-size:0.9rem; color:var(--gray-400);">判定なし（レビューで確定した異常から付けます）</p>
        <% end %>
      </div>
    </div>
    <% if (review_message = inspection_review_message(@inspection)) %>
      <p style="font-size:0.8rem; color:#ef9f27; margin-top:0.75rem;"><%= review_message %></p>
    <% end %>
    <% if (unresolved = @images.count { |i| i.needs_review? || i.failed? }).positive? %>
      <p class="text-xs mt-2"><%= link_to "要確認・失敗の画像 #{unresolved} 枚を、理由ごとにまとめて除外する", inspection_bulk_exclusion_path(@inspection) %></p>
    <% end %>
    <% if @inspection.inspection_images.any?(&:completed?) %>
      <div class="mt-3">
        <% if @inspection.panel_candidates.exists? %>
          <%= link_to "パネルごとの候補を確認する（未判断 #{@inspection.panel_candidates.pending.count} 件）", inspection_panel_review_path(@inspection), class: "btn btn-primary" %>
        <% end %>
        <%= link_to "異常候補をレビューする（未確定 #{@inspection.candidate_count} 件）", review_inspection_path(@inspection), class: @inspection.panel_candidates.exists? ? "btn btn-secondary" : "btn btn-primary" %>
        <% if @inspection.completed? || @inspection.inspection_reports.exists? %>
          <%= link_to "報告書（#{@inspection.inspection_reports.count} 版発行）", inspection_reports_path(@inspection), class: "btn btn-secondary" %>
        <% end %>
        <% if @inspection.completed? %>
          <span class="text-xs text-gray-400 ml-2">レビュー完了: <%= @inspection.reviewed_at.strftime("%Y/%m/%d %H:%M") %></span>
        <% end %>
      </div>
      <% if @inspection.inspection_reports.exists? && (issue = ReportIssue.new(@inspection)).changed_since_latest? %>
        <p class="text-xs mt-2" id="report-changed" style="color:#ef9f27;"><%= issue.latest.title %>の発行後に変更があります（<%= link_to "報告書", inspection_reports_path(@inspection) %>で改訂版を発行できます）</p>
      <% end %>
    <% end %>
    <% if @inspection.candidate_count.positive? %>
      <div class="mt-3 flex items-center gap-3">
        <%= button_to "未確定の異常を現在の判定基準で再判定", rejudge_inspection_path(@inspection), class: "btn btn-sm btn-secondary" %>
        <span class="text-xs text-gray-400">確定済みのものは変わりません。mild を下げた場合、新しい候補を出すには画像の再解析が必要です。</span>
      </div>
    <% end %>
    <% if (unassigned = @inspection.anomalies.where(panel_reassignment_required: true).count).positive? %>
      <p style="font-size:0.8rem; color:#ef9f27; margin-top:0.75rem;">
        配置の置き換えでパネルの割り当てが外れた異常が <%= unassigned %> 件あります（重大度・レビューの結果は変わっていません）。
        <%= link_to "割り当て直しの一覧", site_panel_layout_path(@inspection.site) %>
      </p>
    <% end %>
    <% if @inspection.weather_note.present? %>
      <p style="font-size:0.8rem; color:var(--gray-400); margin-top:0.75rem;">天候メモ: <%= @inspection.weather_note %></p>
    <% end %>
    <% if @inspection.in_progress? %>
      <p style="font-size:0.8rem; color:#5DCAA5; margin-top:0.75rem;"><span class="animate-spin">⚙</span> 品質チェック・解析を行っています...</p>
    <% end %>
  </div>

  <%# ── 所見・総括（レビュー完了後） ─────────────────────────────── %>
  <% if @inspection.completed? && @inspection.reviewed_at.present? %>
    <%= render "findings" %>
  <% end %>

  <%# ── 架台の地図（docs/LAYOUT_OVERLAY_DESIGN.md の A-3） ─────────────── %>
  <% usable = @inspection.inspection_images.count { |i| i.georef&.dig("usable") } %>
  <div class="card p-4" id="block-map">
    <p style="font-size:0.65rem; font-weight:600; color:var(--gray-400); text-transform:uppercase; letter-spacing:0.1em; margin-bottom:0.75rem;">架台の地図（発電所ごとに 1 回）</p>
    <p class="text-xs text-gray-500 mb-2">
      この点検の画像のうち、位置合わせに使える画像（RTK 固定解・真下向き）<%= usable %> 枚から、架台の地図の候補を作ります。
      候補は確認画面と CSV で確かめてから「架台の登録」で登録します（自動では登録しません）。登録済みの架台: <%= @inspection.site.pv_blocks.count %> 個
    </p>
    <% if (latest = @inspection.block_map_proposals.order(created_at: :desc).first) %>
      <p class="text-xs mb-2">前回の候補: <%= link_to "#{BlockMapProposal::STATUS_LABELS[latest.status]}（#{latest.created_at.strftime('%m/%d %H:%M')}）", site_block_map_proposal_path(@inspection.site, latest) %></p>
    <% end %>
    <% if usable.positive? %>
      <%= form_with url: site_block_map_proposals_path(@inspection.site), class: "flex flex-wrap items-end gap-3" do %>
        <%= hidden_field_tag :inspection_id, @inspection.id %>
        <label class="text-xs">モジュールの幅（m）<%= number_field_tag :module_width_m, nil, step: 0.001, min: 0.3, max: 3, required: true, class: "form-input", style: "width:7rem;" %></label>
        <label class="text-xs">長さ（m）<%= number_field_tag :module_length_m, nil, step: 0.001, min: 0.3, max: 3, required: true, class: "form-input", style: "width:7rem;" %></label>
        <label class="text-xs">段数の既定値<%= number_field_tag :rows, 2, min: 1, max: 50, class: "form-input", style: "width:5rem;" %></label>
        <label class="text-xs">パネルの向く方位<%= number_field_tag :facing_azimuth_deg, 180, min: 0, max: 360, class: "form-input", style: "width:6rem;" %></label>
        <%= submit_tag "架台の地図の候補を作る", class: "btn btn-secondary" %>
      <% end %>
    <% end %>
  </div>

  <%# ── 測定パラメータ ─────────────────────────────── %>
  <div class="card p-4" id="measurement">
    <p style="font-size:0.65rem; font-weight:600; color:var(--gray-400); text-transform:uppercase; letter-spacing:0.1em; margin-bottom:0.75rem;">測定パラメータ（任意）</p>
    <p class="text-xs text-gray-400 mb-3">
      R-JPEG から温度を求めるときに使う値です。未入力の項目は渡さず、カメラの既定値（画像に記録された値）のままになります。
      距離は、画像ごとのレーザー距離計の値を優先して使い、それが無い画像だけこの入力を使います。湿度は気象データの値を使います。
      放射率は、根拠のある値が分かるまで空欄のまま（カメラ既定値）にしてください。値を変えたら、解析済みの画像は再解析で反映してください。.npy の合成データでは使いません。
    </p>
    <% ranges = AnalyzerConfig.current.measurement_ranges %>
    <%= form_with model: @inspection, url: measurement_inspection_path(@inspection), method: :patch, class: "flex flex-wrap items-end gap-3" do |f| %>
      <label class="text-sm">放射率<br><%= f.number_field :emissivity, step: 0.001, min: ranges["emissivity"][0], max: ranges["emissivity"][1], class: "form-input", style: "width:7rem;" %></label>
      <label class="text-sm">反射温度（℃）<br><%= f.number_field :reflected_temperature_c, step: 0.1, min: ranges["reflected_temperature_c"][0], max: ranges["reflected_temperature_c"][1], class: "form-input", style: "width:7rem;" %></label>
      <label class="text-sm">距離（m）<br><%= f.number_field :object_distance_m, step: 0.1, min: ranges["distance_m"][0], max: ranges["distance_m"][1], class: "form-input", style: "width:7rem;" %></label>
      <%= f.submit "保存", class: "btn btn-sm btn-secondary" %>
    <% end %>
  </div>

  <%# ── 気象データ ─────────────────────────────── %>
  <div class="card p-4" id="weather">
    <p style="font-size:0.65rem; font-weight:600; color:var(--gray-400); text-transform:uppercase; letter-spacing:0.1em; margin-bottom:0.75rem;">気象データ</p>
    <p class="text-xs text-gray-400 mb-3">
      時刻付きで入力すると、各画像の撮影時刻に合わせて補間して割り当てます（前後 <%= ImageQualityConfig.current.weather_max_gap_minutes %> 分以内の値のみ使用）。
      時刻は <%= @capture_time_zone.name %> の現地時刻として扱います。日射量はモジュール面（POA）か水平面（GHI）かを必ず選んでください。
      雲量（オクタ。0 = 雲なし 〜 8 = 全天が雲）は撮影条件の記録で、画像の判定にはまだ使いません。
    </p>

    <% readings = @inspection.weather_readings.select(&:persisted?) %>
    <% if readings.any? %>
      <table class="table mb-4">
        <thead>
          <tr><th>時刻</th><th>日射量</th><th>種類</th><th>風速</th><th>気温</th><th>湿度</th><th>雲量</th><th></th></tr>
        </thead>
        <tbody>
          <% readings.each do |r| %>
            <tr>
              <td><%= r.observed_at.in_time_zone(@capture_time_zone).strftime("%Y/%m/%d %H:%M") %></td>
              <td><%= r.irradiance_w_m2 ? "#{r.irradiance_w_m2.to_f.round} W/m²" : "-" %></td>
              <td><%= { "poa" => "POA", "ghi" => "GHI", "unknown" => "不明" }.fetch(r.irradiance_type.to_s, "-") %></td>
              <td><%= r.wind_speed_m_s ? "#{r.wind_speed_m_s.to_f} m/s" : "-" %></td>
              <td><%= r.air_temp_c ? "#{r.air_temp_c.to_f} ℃" : "-" %></td>
              <td><%= r.humidity ? "#{r.humidity.to_f} %" : "-" %></td>
              <td><%= r.cloud_cover_okta ? "#{r.cloud_cover_okta}/8" : "-" %></td>
              <td>
                <%= button_to "削除", inspection_weather_reading_path(@inspection, r), method: :delete,
                    class: "btn btn-sm btn-danger", data: { turbo_confirm: "この気象データを削除しますか？" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

    <%= form_with model: @new_reading, url: inspection_weather_readings_path(@inspection), class: "grid grid-cols-2 md:grid-cols-4 gap-3 items-end" do |f| %>
      <div>
        <label class="form-label">時刻</label>
        <%= f.datetime_local_field :observed_at, class: "form-input", required: true,
            value: @inspection.conducted_at.in_time_zone(@capture_time_zone).strftime("%Y-%m-%dT%H:%M") %>
      </div>
      <div>
        <label class="form-label">日射量（W/m²）</label>
        <%= f.number_field :irradiance_w_m2, class: "form-input", step: 1, min: 0 %>
      </div>
      <div>
        <label class="form-label">日射量の種類</label>
        <%= f.select :irradiance_type, [ [ "選択してください", "" ], [ "POA（モジュール面）", "poa" ], [ "GHI（水平面）", "ghi" ], [ "不明", "unknown" ] ], {}, class: "form-select" %>
      </div>
      <div>
        <label class="form-label">風速（m/s）</label>
        <%= f.number_field :wind_speed_m_s, class: "form-input", step: 0.1, min: 0 %>
      </div>
      <div>
        <label class="form-label">気温（℃）</label>
        <%= f.number_field :air_temp_c, class: "form-input", step: 0.1 %>
      </div>
      <div>
        <label class="form-label">湿度（%）</label>
        <%= f.number_field :humidity, class: "form-input", step: 1, min: 0, max: 100 %>
      </div>
      <div>
        <label class="form-label">雲量（オクタ）</label>
        <%= f.select :cloud_cover_okta, [ [ "未記録", "" ] ] + (0..8).map { |n| [ "#{n}/8#{ { 0 => '（雲なし）', 8 => '（全天が雲）' }[n] }", n ] }, {}, class: "form-select" %>
      </div>
      <div>
        <%= f.submit "気象データを追加", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>

  <%# ── 画像ごとの状況 ─────────────────────────────── %>
  <div class="card">
    <table class="table">
      <thead>
        <tr>
          <th>#</th>
          <th>サーモ画像</th>
          <th>撮影</th>
          <th>温度データ</th>
          <th>日射量</th>
          <th>状況</th>
          <th>RGB</th>
        </tr>
      </thead>
      <tbody>
        <% @images.each do |image| %>
          <tr id="image_<%= image.id %>">
            <td><%= image.sequence %></td>
            <td>
              <div style="font-size:0.8rem;"><%= image.thermal_filename %></div>
              <div class="text-xs text-gray-400">
                <%= image.camera_model || "カメラ不明" %>
                <% if image.width %> / <%= image.width %>×<%= image.height %><% end %>
              </div>
            </td>
            <td class="text-xs">
              <%= image.captured_at ? image.captured_at.in_time_zone(@capture_time_zone).strftime("%m/%d %H:%M:%S") : "-" %>
              <div class="text-gray-400"><%= image.gps_lat && image.gps_lng ? "GPS あり" : "GPS なし" %></div>
            </td>
            <td class="text-xs"><%= image.quality_pending? ? "-" : radiometric_label(image) %></td>
            <td class="text-xs"><%= irradiance_label(image) %></td>
            <td>
              <span class="badge <%= image_status_badge_class(image) %>"><%= image_status_label(image) %></span>
              <% if image.needs_review? || image.failed? %>
                <p class="text-xs mt-1" style="color:#ef9f27;"><%= image_review_message(image) %></p>
              <% end %>
              <% if image.excluded? %>
                <p class="text-xs mt-1 text-gray-400">除外の理由: <%= image.exclusion_note %></p>
              <% end %>

              <% if image.quality_report.present? %>
                <details class="mt-1">
                  <summary class="text-xs text-gray-400" style="cursor:pointer;">品質チェックの詳細</summary>
                  <ul class="text-xs mt-1 space-y-1">
                    <% image.quality_report["checks"].each do |check| %>
                      <li><%= quality_check_icon(check["result"]) %> <%= check["message"] %></li>
                    <% end %>
                  </ul>
                  <p class="text-xs text-gray-400 mt-1">判定基準: <%= image.quality_report["config_version"] %></p>
                </details>
              <% end %>

              <div class="mt-2 flex flex-wrap gap-2">
                <% if image.ready_for_analysis? %>
                  <%= link_to image.panel_grids.present? ? "グリッドを編集（#{image.panel_grids.size}個）" : "グリッドを指定", grid_inspection_inspection_image_path(@inspection, image), class: "btn btn-sm btn-primary" %>
                <% end %>
                <% if image.ready_for_analysis? && image.panel_grids.present? && (image.completed? || image.needs_review? || image.failed?) %>
                  <%= button_to "再解析", reanalyze_inspection_inspection_image_path(@inspection, image), class: "btn btn-sm btn-secondary",
                      data: { turbo_confirm: "未確定の異常の候補を作り直して解析し直しますか？確定済みの異常は残ります" } %>
                <% end %>
              </div>

              <% if image.measurement_params.present? && !image.npy_thermal? %>
                <p class="text-xs text-gray-400 mt-1">測定パラメータ: <%= ThermalMeasurement.describe(image.measurement_params).join("・") %></p>
              <% end %>
              <% if (al = image.alignment).present? %>
                <% if al["status"] == "aligned" %>
                  <p class="text-xs mt-1 text-gray-400">架台との位置合わせ: 自動（残差 パネル幅の <%= al.dig("residual", "panel_width_ratio") %>・閾値 <%= al["threshold_ratio"] %>。架台 <%= al["blocks_in_view"] %> 個）</p>
                <% else %>
                  <p class="text-xs mt-1" style="color:#ef9f27;">架台との位置合わせ: できませんでした — <%= al["message"] %><%= "（残差 パネル幅の #{al.dig('residual', 'panel_width_ratio')}）" if al.dig("residual", "panel_width_ratio") %></p>
                <% end %>
              <% end %>
              <% if image.georef.present? %>
                <p class="text-xs mt-1" style="color:<%= image.georef["usable"] ? "var(--gray-400)" : "#ef9f27" %>;">位置: <%= ImageGeoref.describe(image.georef) %></p>
              <% end %>
              <% unless ThermalMeasurement.new(image).current? %>
                <p class="text-xs mt-1" style="color:#ef9f27;">解析した後に測定パラメータ（または湿度）が変わっています。反映するには再解析してください。</p>
              <% end %>
              <% if image.raw_analysis.present? && image.completed? %>
                <details class="mt-1">
                  <summary class="text-xs text-gray-400" style="cursor:pointer;">解析結果（基準温度 <%= image.raw_analysis.dig("baseline", "method") == "position_trend" ? "（位置の傾向の中央値）" : "" %><%= image.raw_analysis.dig("baseline", "temp") %>℃・パネル <%= Array(image.raw_analysis["panels"]).size %> 枚・候補 <%= image.anomalies.size %> 件）</summary>
                  <% if image.anomalies.any? %>
                    <table class="text-xs mt-1" style="width:100%;">
                      <tr class="text-gray-400"><th>パネル</th><th>種類</th><th>重大度</th><th>ΔT</th><th>判定</th><th>状態</th></tr>
                      <% image.anomalies.order(:panel_index_in_image).each do |anomaly| %>
                        <tr>
                          <td><%= anomaly.panel_index_in_image %></td>
                          <td>
                            <%= anomaly_type_label(anomaly.anomaly_type) %><%= "（帯 #{anomaly.active_bands} 本）" if anomaly.active_bands %>
                            <%= "・群" if anomaly.anomaly_group_id %>
                          </td>
                          <td><%= anomaly_severity_label(anomaly.severity) %></td>
                          <td>
                            <%= anomaly.delta_t&.to_f %>℃
                            <%= anomaly.threshold_basis == "normalized" ? "（正規化 #{anomaly.normalized_delta_t&.to_f}℃）" : "（未正規化）" %>
                          </td>
                          <td><%= anomaly.detection == "baseline" ? "基準温度から" : "局所" %><%= "・グレア疑い" if anomaly.flags.include?("glare_suspect") %></td>
                          <td><%= anomaly.review_status == "pending" ? "候補" : anomaly.review_status %></td>
                        </tr>
                      <% end %>
                    </table>
                  <% else %>
                    <p class="text-xs mt-1">異常の候補はありません（レビューで画像を確認してください）</p>
                  <% end %>
                </details>
              <% end %>

              <% if image.needs_review? || image.failed? %>
                <%= form_with model: image, url: exclude_inspection_inspection_image_path(@inspection, image), method: :patch, class: "mt-2 flex gap-2" do |f| %>
                  <%= f.text_field :exclusion_note, class: "form-input", placeholder: "除外の理由（必須）", required: true, style: "font-size:0.75rem; padding:0.25rem 0.5rem;" %>
                  <%= f.submit "除外する", class: "btn btn-sm btn-secondary" %>
                <% end %>
              <% elsif image.excluded? %>
                <%= button_to "除外を取り消す", unexclude_inspection_inspection_image_path(@inspection, image), method: :patch, class: "btn btn-sm btn-secondary mt-2" %>
              <% end %>
            </td>
            <td class="text-xs">
              <% if image.rgb.attached? %>
                <div><%= image.rgb.filename %></div>
                <%= button_to "外す", rgb_inspection_inspection_image_path(@inspection, image), method: :delete,
                    class: "btn btn-sm btn-secondary mt-1", data: { turbo_confirm: "RGB 画像を外しますか？" } %>
              <% else %>
                <span class="text-gray-400">なし</span>
              <% end %>
              <%= form_with model: image, url: inspection_inspection_image_path(@inspection, image), method: :patch, class: "mt-1" do |f| %>
                <%= f.file_field :rgb, accept: "image/*", class: "text-xs", required: true %>
                <%= f.submit image.rgb.attached? ? "差し替え" : "添付", class: "btn btn-sm btn-secondary mt-1" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
