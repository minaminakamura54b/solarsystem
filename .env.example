# Claude API
# Claude の API キー（アプリ専用の名前。シェルの ANTHROPIC_API_KEY は使わない）
SOLARSIGHT_ANTHROPIC_API_KEY=your_anthropic_api_key_here
# 確定した異常の所見と総括文の作成に使う Claude のモデル名（必須。コードには書かない）
# 例: claude-opus-5-5（品質優先）/ claude-sonnet-5-5（費用を抑える）。未設定なら所見を作らずエラーを表示する
SOLARSIGHT_CLAUDE_MODEL=claude-opus-5-5

# DJI Thermal SDK の dji_irp のパス（docs/PHASE_S_RUNBOOK.md）。SDK は x86_64 Linux 向け（Mac では Docker の linux/amd64 の中で使う）
DJI_IRP_PATH=
# SDK の共有ライブラリのディレクトリ（dji_irp と同じ場所なら不要）
DJI_IRP_LIB_DIR=
# 開発用: 1 にすると、解析エンジンを Docker（linux/amd64）のコンテナの中で動かす（Mac で実画像を解析するため）。
# コンテナは bin/analyzer-container up で用意する。DJI_IRP_PATH はホストと同じパス（プロジェクトを同じパスでマウントするため）
ANALYZER_DOCKER=

# Database (本番環境)
DATABASE_URL=postgresql://user:password@host/solarsystem_production

# AWS S3 (本番環境の画像保存。Phase 8 で使用)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-northeast-1
AWS_BUCKET=your-bucket-name
