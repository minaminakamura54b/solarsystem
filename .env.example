# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# 確定した異常の所見と総括文の作成に使う Claude のモデル名（必須。コードには書かない）
# 例: claude-opus-5-5（品質優先）/ claude-sonnet-5-5（費用を抑える）。未設定なら所見を作らずエラーを表示する
CLAUDE_MODEL=claude-opus-5-5

# DJI Thermal SDK の dji_irp のパス（Phase 3 以降で使用）
DJI_IRP_PATH=

# Database (本番環境)
DATABASE_URL=postgresql://user:password@host/solarsystem_production

# AWS S3 (本番環境の画像保存。Phase 8 で使用)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-northeast-1
AWS_BUCKET=your-bucket-name
